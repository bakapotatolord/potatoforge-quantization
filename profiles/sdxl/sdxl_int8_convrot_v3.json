{
  "format_version": 1,
  "profile_id": "sdxl_int8_convrot_v3",
  "description": "Aggressive SDXL combined-checkpoint profile. Diffusion uses INT8 ConvRot with plain INT8 fallback. CLIP-L quantizes token/position embeddings and transformer Linear layers 0-10 with INT8 ConvRot while keeping layer 11. CLIP-G uses INT8 for known-safe out_proj/MLP weights and INT8 ConvRot with INT8 fallback for fused attn.in_proj_weight QKV tensors. VAE and all other tensors remain unchanged.",
  "default": "keep",
  "rules": [
    {
      "action": "keep",
      "prefix": "conditioner.embedders.0.transformer.text_model.encoder.layers.11.",
      "suffixes": [
        ".mlp.fc1.weight",
        ".mlp.fc2.weight",
        ".self_attn.k_proj.weight",
        ".self_attn.out_proj.weight",
        ".self_attn.q_proj.weight",
        ".self_attn.v_proj.weight"
      ]
    },
    {
      "action": "int8_convrot",
      "prefix": "conditioner.embedders.0.transformer.text_model.embeddings.",
      "suffixes": [".position_embedding.weight", ".token_embedding.weight"]
    },
    {
      "action": "int8_convrot",
      "prefix": "conditioner.embedders.0.transformer.text_model.encoder.layers.",
      "suffixes": [
        ".mlp.fc1.weight",
        ".mlp.fc2.weight",
        ".self_attn.k_proj.weight",
        ".self_attn.out_proj.weight",
        ".self_attn.q_proj.weight",
        ".self_attn.v_proj.weight"
      ]
    },
    {
      "action": "int8",
      "prefix": "conditioner.embedders.1.model.transformer.resblocks.",
      "suffixes": [".attn.out_proj.weight", ".mlp.c_fc.weight", ".mlp.c_proj.weight"]
    },
    {
      "action": "int8_convrot",
      "fallback": "int8",
      "prefix": "conditioner.embedders.1.model.transformer.resblocks.",
      "suffixes": [".attn.in_proj_weight"]
    },
    {
      "action": "int8_convrot",
      "fallback": "int8",
      "prefix": "model.diffusion_model.",
      "suffixes": [".weight"]
    }
  ]
}
